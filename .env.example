# Gaia Project server 环境变量示例
# 复制为 .env 并按需填写（.env 不入库）。

# Anthropic API key：AI 座位的 LLM 决策用。
# 缺失时 server 启动警告，AI 座位用内置插件（GAIA_AI_SPEC，缺省 builtin:heuristic），不产生 LLM 调用。
ANTHROPIC_API_KEY=

# 服务器端口（默认 8430）
# PORT=8430

# SQLite 数据库路径（默认 ./gaia.db）
# DB_PATH=./gaia.db

# web 构建产物目录：存在则同端口托管静态文件（生产单端口模式；dev 不设，走 vite proxy）
# WEB_DIST=packages/web/dist

# 覆盖 LLM 模型（默认按难度：easy=claude-haiku-4-5，normal/hard=claude-sonnet-4-5）
# GAIA_AI_MODEL=

# 无 ANTHROPIC_API_KEY 时的 AI 插件（缺省 builtin:heuristic；可选见 server 启动日志）
# GAIA_AI_SPEC=builtin:heuristic

# 每步 AI 行动间隔毫秒（默认 300，0 = 不减速）
# GAIA_AI_PACE_MS=300
